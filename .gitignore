# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging and test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Experiment outputs.
# Derived analyses are regenerated by the scripts and stay out of the repository.
# The raw hardware readouts under results/hardware/ ARE published: they are the
# primary evidence behind every table in doc_tex/, and the repository is cited
# for reproducibility.
# Note the 'results/*' form: with 'results/' git would not descend into the
# directory and the '!' exception below would never be reached.
results/*
!results/hardware/
data/raw/
data/processed/
*.log
*.tmp

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
# The current build of the report, doc_tex/main_v1.pdf, is published on purpose.
# The earlier main.pdf build is superseded and stays out.
doc_tex/main.pdf

# IBM credentials
qiskit-ibm.json
ibm_quantum_token*

# OS/editor
.DS_Store
.vscode/
.idea/
